{
  "name": "cv-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "odt:prepare": "tsx scripts/prepare-odt-template.ts",
    "odt:sync": "tsx scripts/sync-odt.ts en && tsx scripts/sync-odt.ts ru",
    "md:sync": "tsx scripts/sync-md.ts en",
    "pdf:sync": "tsx scripts/sync-pdf.ts en && tsx scripts/sync-pdf.ts ru",
    "cv:sync": "npm run odt:sync && npm run md:sync && npm run pdf:sync",
    "public:copy": "tsx scripts/copy-to-public.ts"
  },
  "dependencies": {
    "gh-pages": "^6.1.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.1",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.19",
    "fast-xml-parser": "^5.8.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}

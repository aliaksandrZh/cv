{
  "odt": {
    "sourceDir": "cv_sources",
    "source": "Aliaksandr.Zhebit copy.odt",
    "template": "cv2026-template.odt",
    "headerLayout": "flat",
    "outputDir": "cv_sources/sync",
    "output": {
      "en": "Aliaksandr.Zhebit.odt",
      "ru": "Aliaksandr.Zhebit-ru.odt"
    },
    "enabled": {
      "en": true,
      "ru": true
    }
  },
  "pdf": {
    "outputDir": "cv_sources/sync",
    "output": {
      "en": "Aliaksandr.Zhebit.pdf",
      "ru": "Aliaksandr.Zhebit-ru.pdf"
    },
    "enabled": {
      "en": true,
      "ru": true
    }
  },
  "public": {
    "copy": ["pdf", "markdown"]
  },
  "markdown": {
    "template": "cv_sources/cv-template.md",
    "outputDir": "cv_sources/sync",
    "output": {
      "en": "Aliaksandr.Zhebit.md",
      "ru": "Aliaksandr.Zhebit-ru.md"
    },
    "enabled": {
      "en": true,
      "ru": true
    }
  }
}
